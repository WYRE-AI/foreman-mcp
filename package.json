{
  "name": "@foreman/mcp",
  "version": "0.1.0",
  "description": "MCP server for the Foreman REST API - hosts, host groups, reports, audits and operations",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-server-foreman": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:destructive": "node scripts/lint-destructive-warnings.mjs src",
    "smoke": "node scripts/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WYRE-AI/foreman-mcp.git"
  },
  "keywords": [
    "mcp",
    "claude",
    "foreman",
    "infrastructure",
    "automation"
  ],
  "author": "Aaron Sachs",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
