{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.WYRE-AI/foreman-mcp",
  "title": "Foreman",
  "description": "MCP server for the Foreman REST API.",
  "repository": {
    "url": "https://github.com/asachs01/foreman-mcp",
    "source": "github"
  },
  "version": "0.0.0",
  "websiteUrl": "https://github.com/asachs01/foreman-mcp",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/wyre-ai/foreman-mcp:0.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "FOREMAN_USERNAME",
          "description": "Foreman username",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "FOREMAN_TOKEN",
          "description": "Foreman Personal Access Token",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "FOREMAN_BASE_URL",
          "description": "Foreman base URL (https; required)",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "FOREMAN_TOOL_TIERS",
          "description": "Tiers to expose: read, write, admin (default read)",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ]
}
