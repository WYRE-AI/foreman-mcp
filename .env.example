# Base URL of your Foreman server (REQUIRED, no default). Any https host is allowed
# (operator-set; private IPs and ports are fine); http only for localhost/127.0.0.1.
# No userinfo, query or fragment.
FOREMAN_BASE_URL=https://foreman.example.com
# Foreman username and Personal Access Token (AUTH_MODE=env and stdio). Never commit real values.
FOREMAN_USERNAME=
FOREMAN_TOKEN=
# Optional PEM CA bundle for a Foreman server with a private/self-signed CA (TLS verification stays on)
# FOREMAN_CA_CERT_FILE=/path/to/ca.pem
# Comma-separated tiers to expose: read, write, admin (default: read)
FOREMAN_TOOL_TIERS=read
# env (default): credentials from FOREMAN_USERNAME/FOREMAN_TOKEN
# gateway: per-request X-Foreman-Username and X-Foreman-Token headers; never falls back to env credentials
AUTH_MODE=env
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=127.0.0.1
# Required for HTTP: >= 32 chars (openssl rand -hex 32); placeholders are rejected
CONDUIT_S2S_SECRET=
# Extra allowed Host header values (no ports), comma separated; DNS-rebinding protection
# MCP_ALLOWED_HOSTS=mcp.example.com
# Local development only: allows an empty CONDUIT_S2S_SECRET, loopback bind only
MCP_ALLOW_INSECURE_DEV=0
LOG_LEVEL=info
